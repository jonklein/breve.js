{
  "name": "hypercycle",
  "seed": 5,
  "clock": { "rate": 20 },
  "world": {
    "preset": "night",
    "grid": false,
    "frame": false,
    "camera": { "distance": 1.5, "elevation": 60, "azimuth": 90 },
    "effects": { "bloom": { "strength": 0.45, "threshold": 0.7 }, "vignette": 0.3 }
  },
  "params": {
    "base": { "value": 0.02, "min": 0, "max": 0.2, "step": 0.005, "label": "copying without help" },
    "help": { "value": 0.5, "min": 0, "max": 2, "step": 0.05, "label": "extra copying with help" },
    "death": { "value": 0.06, "min": 0.01, "max": 0.3, "step": 0.005 },
    "fill": { "value": 0.5, "min": 0.05, "max": 1, "step": 0.05, "label": "starting fill (after Reset)" },
    "parasites": { "value": 0, "min": 0, "max": 4, "step": 0.1, "label": "parasites (0 = none; after Reset)" }
  },
  "entities": [
    {
      "name": "cell",
      "controller": "hypercycle.js",
      "lattice": { "size": [80, 1, 80], "spacing": 1, "edges": "wrap", "thickness": 0.5 },
      "style": { "shape": "rounded", "material": { "roughness": 0.45, "glow": 0.5 } }
    }
  ],
  "metrics": ["member1", "member2", "member3", "member4", "member5", "parasites"],
  "charts": [{ "title": "who holds how many cells", "metrics": ["member1", "member2", "member3", "member4", "member5", "parasites"] }]
}
