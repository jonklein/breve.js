{
  "name": "breve",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "run": "node --import tsx scripts/run.mjs",
    "urdf": "node --import tsx scripts/urdf.mjs",
    "mjcf": "node --import tsx scripts/mjcf.mjs",
    "docs": "node scripts/gen-docs.mjs",
    "build": "npm run build -w @breve/workbench",
    "test": "npm test -w @breve/stdlib && npm test -w @breve/experiment && npm test -w @breve/core && npm test -w @breve/server && npm test -w @breve/inference",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
