{
  "name": "boids",
  "seed": 7,
  "bounds": { "size": 30 },
  "world": { "preset": "dusk", "grid": false, "agentColor": "heading", "shadows": true, "floor": { "texture": { "kind": "grid", "colors": ["#5a4670","#1b1328"], "scale": 6, "tile": 30}, "roughness": 0.6}},
  "params": {
    "count": { "value": 300, "min": 10, "max": 1500, "step": 10 },
    "radius": { "value": 7, "min": 1, "max": 15, "step": 0.5, "label": "neighbor radius" },
    "separationRadius": { "value": 2.2, "min": 0.5, "max": 6, "step": 0.1 },
    "cohesion": { "value": 0.5, "min": 0, "max": 3, "step": 0.05 },
    "alignment": { "value": 1.8, "min": 0, "max": 6, "step": 0.1 },
    "separation": { "value": 14, "min": 0, "max": 40, "step": 0.5 },
    "wander": { "value": 50, "min": 0, "max": 120, "step": 1, "label": "random jitter" },
    "maxSpeed": { "value": 26, "min": 1, "max": 40, "step": 0.5 },
    "minSpeed": { "value": 14, "min": 0, "max": 30, "step": 0.5 }
  },
  "entities": [
    {
      "name": "boid", "style": {"shape": "cone", "material": {"roughness": 0.3, "metalness": 0.35, "glow": 0.25}},
      "count": "$count",
      "controller": "flock.js",
      "sensors": [{ "type": "neighbors", "radius": "$radius" }],
      "motion": { "maxSpeed": "$maxSpeed", "minSpeed": "$minSpeed", "maxAccel": 60 }
    }
  ],
  "metrics": ["polarization"]
}
