{
  "name": "life3d",
  "seed": 3,
  "clock": { "rate": 8 },
  "world": {
    "sky": { "top": "#05070d", "horizon": "#101a2e" },
    "grid": false,
    "boundsColor": "#3a4658",
    "agentColor": "heading"
  },
  "params": {
    "density": { "value": 0.2, "min": 0.02, "max": 0.6, "step": 0.01, "label": "starting density" }
  },
  "entities": [
    {
      "name": "cell",
      "lattice": { "size": [20, 20, 20], "spacing": 1.2, "edges": "wrap", "show": "alive", "color": "age", "colorMax": 20 },
      "state": { "alive": 0, "age": 0 },
      "fill": { "field": "alive", "density": "$density" },
      "controller": "life.js"
    }
  ],
  "metrics": ["population"]
}
