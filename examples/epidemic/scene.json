{
  "name": "epidemic",
  "seed": 8,
  "clock": { "rate": 5 },
  "world": { "frame": false, "preset": "night", "light": { "toneMapping": "neutral" }, "effects": { "bloom": { "strength": 0.1 }, "saturation": 1.4 }, "camera": {"distance": 2.4, "elevation": 10}, "grid": false, "fog": false },
  "controls": [
    { "label": "Layout", "set": "entities.0.network.layout", "options": ["force-sphere", "force", "sphere", "circle", "radial"] }
  ],
  "params": {
    "infectiousness": { "value": 0.03, "min": 0, "max": 0.5, "step": 0.01, "label": "chance per sick neighbor" },
    "recoveryTime": { "value": 14, "min": 2, "max": 50, "step": 1, "label": "ticks until recovered" }
  },
  "entities": [
    {
      "name": "people", "style": {"material": {"roughness": 0.5, "glow": 0.45}},
      "count": 300,
      "controller": "contagion.js",
      "network": { "topology": "smallworld", "degree": 6, "rewire": 0.08, "layout": "force-sphere", "radius": 24, "size": 1.3, "links": { "opacity": 0.3, "brightness": 0.35 } }
    }
  ],
  "metrics": ["susceptible", "infected", "recovered"],
  "charts": [{ "title": "who is what", "metrics": ["susceptible", "infected", "recovered"] }]
}
