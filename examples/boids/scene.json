{
  "name": "boids",
  "seed": 7,
  "bounds": { "size": 30, "mode": "soft" },
  "world": {
    "sky": { "top": "#0b1226", "horizon": "#2a4a7a" },
    "grid": true,
    "boundsColor": "#3a4658",
    "agentColor": "heading"
  },
  "params": {
    "count": { "value": 300, "min": 10, "max": 1500, "step": 10 },
    "radius": { "value": 7, "min": 1, "max": 15, "step": 0.5, "label": "neighbor radius" },
    "separationRadius": { "value": 2.2, "min": 0.5, "max": 6, "step": 0.1 },
    "cohesion": { "value": 0.8, "min": 0, "max": 3, "step": 0.05 },
    "alignment": { "value": 2, "min": 0, "max": 6, "step": 0.1 },
    "separation": { "value": 14, "min": 0, "max": 40, "step": 0.5 },
    "maxSpeed": { "value": 9, "min": 1, "max": 20, "step": 0.5 },
    "minSpeed": { "value": 4, "min": 0, "max": 10, "step": 0.5 }
  },
  "entities": [
    {
      "name": "boid",
      "count": "$count",
      "controller": "flock.js",
      "sensors": [{ "type": "neighbors", "radius": "$radius" }],
      "motion": { "maxSpeed": "$maxSpeed", "minSpeed": "$minSpeed", "maxAccel": 30 }
    }
  ],
  "metrics": ["polarization"]
}
