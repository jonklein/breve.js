{
  "name": "gray-scott",
  "seed": 3,
  "time": { "step": 1, "unit": "step", "pace": 24 },
  "world": {
    "preset": "studio",
    "grid": false,
    "frame": false,
    "camera": { "distance": 1.45, "elevation": 62, "azimuth": 90 },
    "sky": { "top": "#0b1020", "horizon": "#161c2e", "ground": "#0b1020" },
    "light": { "sun": { "intensity": 1.8, "elevation": 60, "azimuth": 40 } },
    "effects": { "bloom": { "strength": 0.25, "threshold": 0.8 }, "vignette": 0.25 }
  },
  "data": { "palette": "aurora" },
  "controls": [
    {
      "label": "Pattern (sets supply and decay)",
      "presets": [
        { "label": "spots", "values": { "params.supply.value": 0.037, "params.decay.value": 0.065 } },
        { "label": "stripes", "values": { "params.supply.value": 0.078, "params.decay.value": 0.061 } },
        { "label": "coral", "values": { "params.supply.value": 0.055, "params.decay.value": 0.062 } },
        { "label": "waves", "values": { "params.supply.value": 0.026, "params.decay.value": 0.051 } },
        { "label": "holes", "values": { "params.supply.value": 0.039, "params.decay.value": 0.058 } },
        { "label": "solitons", "values": { "params.supply.value": 0.03, "params.decay.value": 0.06 } }
      ]
    },
    { "label": "Palette", "set": "data.palette", "options": ["ocean", "aurora", "fire", "rainbow", "candy", "mono"] }
  ],
  "params": {
    "supply": { "value": 0.037, "min": 0.01, "max": 0.1, "step": 0.0005, "label": "supply (how fast u is topped up)" },
    "decay": { "value": 0.065, "min": 0.04, "max": 0.075, "step": 0.0002, "label": "decay (how fast v breaks down)" },
    "diffusionU": { "value": 1, "min": 0.2, "max": 1, "step": 0.01, "label": "diffusion of u (how fast it spreads out)" },
    "diffusionV": { "value": 0.5, "min": 0.1, "max": 0.8, "step": 0.01, "label": "diffusion of v (how fast it spreads out)" },
    "speed": { "value": 8, "min": 1, "max": 24, "step": 1, "label": "small steps per tick" },
    "brightness": { "value": 3, "min": 1, "max": 6, "step": 0.1, "label": "color brightness" },
    "blobs": { "value": 14, "min": 1, "max": 80, "step": 1, "label": "starting blobs (after Reset)" }
  },
  "entities": [
    {
      "name": "cell",
      "controller": "gray-scott.js",
      "lattice": { "size": [128, 1, 128], "spacing": 1, "edges": "wrap", "thickness": 0.35 },
      "style": { "material": { "roughness": 0.55, "glow": 0.25 } }
    }
  ],
  "metrics": ["chemicalV"]
}
