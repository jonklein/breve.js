{
  "name": "epidemic on a grid",
  "seed": 8,
  "clock": { "rate": 10 },
  "world": { "sky": { "top": "#070b14", "horizon": "#162238" }, "grid": false },
  "params": {
    "infectiousness": { "value": 0.05, "min": 0, "max": 0.5, "step": 0.01, "label": "chance per sick neighbor" },
    "recoveryTime": { "value": 14, "min": 2, "max": 50, "step": 1, "label": "ticks until recovered" }
  },
  "entities": [
    {
      "name": "people",
      "controller": "../epidemic/contagion.js",
      "lattice": { "size": [30, 1, 30], "spacing": 1, "edges": "wrap", "show": "present", "color": "status", "colorMax": 2, "thickness": 0.3, "palette": ["#6aa7ff", "#ff5b5b", "#7bd88f"] },
      "state": { "present": 1, "status": 0, "timer": 0 },
      "fill": { "field": "status", "value": 1, "count": 3 }
    }
  ],
  "metrics": ["susceptible", "infected", "recovered"],
  "charts": [{ "title": "who is what", "metrics": ["susceptible", "infected", "recovered"] }]
}
