{
  "name": "neural",
  "seed": 11,
  "bounds": { "size": 20 },
  "world": { "sky": { "top": "#10091f", "horizon": "#3b2a63" }, "grid": true, "boundsColor": "#4a3f6b", "agentColor": "heading" },
  "params": {
    "count": { "value": 100, "min": 10, "max": 400, "step": 10 },
    "radius": { "value": 8, "min": 2, "max": 16, "step": 0.5, "label": "how far they see" },
    "maxSpeed": { "value": 7, "min": 1, "max": 15, "step": 0.5 },
    "push": { "value": 12, "min": 1, "max": 40, "step": 1, "label": "how hard the brain can steer" }
  },
  "entities": [
    {
      "name": "thinker",
      "count": "$count",
      "controller": "brain.js",
      "sensors": [{ "type": "neighbors", "radius": "$radius" }],
      "motion": { "maxSpeed": "$maxSpeed", "minSpeed": 2, "maxAccel": 40 }
    }
  ],
  "metrics": ["spread"]
}
