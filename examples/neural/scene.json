{
  "name": "neural",
  "seed": 11,
  "bounds": { "size": 20 },
  "world": { "frame": false, "preset": "night", "sky": { "top": "#10091f", "horizon": "#3b2a63" }, "fog": { "color": "#2a1f4a" }, "grid": false, "agentColor": "heading", "shadows": true, "camera": { "distance": 1.6, "elevation": 55 }, "floor": { "texture": { "kind": "grid", "colors": ["#4a3a80", "#150d2b"], "scale": 6, "tile": 30 }, "roughness": 0.92 } },
  "params": {
    "population": { "value": 16, "min": 4, "max": 32, "step": 1, "label": "brains per generation" },
    "ticks": { "value": 250, "min": 120, "max": 1200, "step": 10, "label": "ticks per generation" },
    "keep": { "value": 3, "min": 1, "max": 8, "step": 1, "label": "best brains kept as they are" },
    "mutation": { "value": 0.3, "min": 0, "max": 0.6, "step": 0.01, "label": "mutation strength" },
    "team": { "value": 12, "min": 2, "max": 40, "step": 1, "label": "walkers sharing each brain" },
    "hop": { "value": 60, "min": 20, "max": 400, "step": 10, "label": "ticks before the goal jumps" },
    "radius": { "value": 8, "min": 2, "max": 16, "step": 0.5, "label": "how far they see" },
    "maxSpeed": { "value": 7, "min": 1, "max": 15, "step": 0.5 },
    "push": { "value": 12, "min": 1, "max": 40, "step": 1, "label": "how hard the brain can steer" }
  },
  "entities": [
    {
      "name": "walker",
      "style": { "trail": { "length": 14, "strength": 0.6 }, "shape": "octahedron", "material": { "roughness": 0.45, "metalness": 0.1, "glow": 0.25 } },
      "count": "$team",
      "size": 1.5,
      "color": "#8fe3ff",
      "controller": "brain.js",
      "spawn": { "at": [0, 0, 0], "spread": 4 },
      "sensors": [{ "type": "neighbors", "radius": "$radius" }],
      "motion": { "maxSpeed": "$maxSpeed", "minSpeed": 2, "maxAccel": 40, "plane": "xz" }
    },
    {
      "name": "goal",
      "type": "Goal",
      "count": 1,
      "controller": "brain.js",
      "size": 2.2,
      "motion": { "maxSpeed": 0.01, "minSpeed": 0, "maxAccel": 0 },
      "color": "#ffd24d",
      "style": { "shape": "sphere", "material": { "roughness": 0.3, "glow": 1 } }
    }
  ],
  "metrics": ["near"]
}
