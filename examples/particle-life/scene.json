{
  "name": "particle life",
  "seed": 3,
  "clock": { "rate": 40 },
  "bounds": { "size": 40 },
  "world": {
    "preset": "night",
    "grid": false,
    "fog": false,
    "frame": false,
    "camera": { "distance": 1.9, "elevation": 86 },
    "effects": { "bloom": { "strength": 0.35, "threshold": 0.6 } }
  },
  "params": {
    "count": { "value": 600, "min": 100, "max": 2500, "step": 50, "label": "particles" },
    "kinds": { "value": 6, "min": 2, "max": 8, "step": 1, "label": "kinds (colors)" },
    "matrixSeed": { "value": 7, "min": 0, "max": 99, "step": 1, "label": "who attracts whom (a new random table for each number)" },
    "symmetry": { "value": 0.3, "min": 0, "max": 1, "step": 0.05, "label": "how mutual the attractions are (1 = both ways the same)" },
    "radius": { "value": 9, "min": 3, "max": 20, "step": 0.5, "label": "how far particles feel each other" },
    "repulsion": { "value": 0.3, "min": 0.05, "max": 0.7, "step": 0.01, "label": "personal space (share of the range)" },
    "strength": { "value": 40, "min": 5, "max": 150, "step": 1, "label": "strength of the pulls" },
    "friction": { "value": 3, "min": 0.5, "max": 12, "step": 0.1, "label": "friction" }
  },
  "entities": [
    {
      "name": "particle",
      "count": "$count",
      "controller": "life.js",
      "size": 0.8,
      "style": { "shape": "sphere", "material": { "roughness": 0.4, "glow": 0.5 } },
      "sensors": [{ "type": "neighbors", "radius": "$radius" }],
      "motion": { "maxSpeed": 60, "plane": "xz" }
    }
  ],
  "metrics": ["energy"]
}
